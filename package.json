{
	"name": "adamgoodapp",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.29.3",
	"engines": {
		"node": ">=22"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
		"check": "biome check",
		"check:write": "biome check --write",
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"capture": "node scripts/capture-fallback.mjs",
		"generate-routes": "tsr generate",
		"deploy": "pnpm build && wrangler deploy",
		"prepare": "lefthook install"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lefthook",
			"lightningcss",
			"workerd"
		]
	},
	"dependencies": {
		"@fontsource/press-start-2p": "^5.3.0",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-separator": "^1.2.0",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-start": "^1.169.3",
		"@tanstack/react-store": "^0.11.2",
		"@tanstack/store": "^0.11.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.59.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"three": "^0.186.1",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.5.15",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@playwright/test": "^1.64.1",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-cli": "^1.167.45",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@webgpu/types": "^0.1.74",
		"babel-plugin-react-compiler": "^1.0.0",
		"jsdom": "^30.1.3",
		"lefthook": "^2.2.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"wrangler": "^4.151.1"
	}
}
