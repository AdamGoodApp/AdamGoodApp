{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adamgoodapp",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// TanStack Start's handler plus the Durable Object exports (src/server.ts).
	"main": "./src/server.ts",
	"routes": [
		{ "pattern": "adamgoodapp.com", "custom_domain": true },
		{ "pattern": "www.adamgoodapp.com", "custom_domain": true }
	],
	"vars": {
		"AI_GATEWAY_ACCOUNT_ID": "c4fe6001a343c827bab996be52394a10",
		"AI_GATEWAY_ID": "main"
	},
	// /api/chat limits per client IP: one ChatRateLimiter Durable Object per IP
	// (src/chat/rate-limiter-object.ts, limits in src/chat/rate-limit.ts).
	"durable_objects": {
		"bindings": [{ "name": "CHAT_LIMITER", "class_name": "ChatRateLimiter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRateLimiter"] }],
	// CV search: Workers AI embeddings into the Vectorize index (src/mcp/semantic-search.ts).
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "CV_INDEX", "index_name": "adamgoodapp-cv" }],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
	}
}
