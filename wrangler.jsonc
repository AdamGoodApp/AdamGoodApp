{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "adamgoodapp",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"routes": [
		{ "pattern": "adamgoodapp.com", "custom_domain": true },
		{ "pattern": "www.adamgoodapp.com", "custom_domain": true }
	],
	"vars": {
		"AI_GATEWAY_ACCOUNT_ID": "c4fe6001a343c827bab996be52394a10",
		"AI_GATEWAY_ID": "main"
	},
	// /api/chat limits per client IP (src/routes/api/chat.ts). One visitor turn can be
	// 2–4 requests (tool results continue the run), so the burst tier allows that.
	"ratelimits": [
		{
			"name": "CHAT_BURST_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 8, "period": 10 }
		},
		{
			"name": "CHAT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	// CV search: Workers AI embeddings into the Vectorize index (src/mcp/semantic-search.ts).
	"ai": { "binding": "AI" },
	"vectorize": [{ "binding": "CV_INDEX", "index_name": "adamgoodapp-cv" }],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
	}
}
